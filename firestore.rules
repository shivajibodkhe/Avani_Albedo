rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /avani_users/{userId} {
      allow read, write: if true;
    }
    match /avani_alerts/{alertId} {
      allow read, write: if true;
    }
    match /avani_scenarios/{scenarioId} {
      allow read, write: if true;
    }
    match /avani_audit/{auditId} {
      allow read, write: if true;
    }
  }
}
