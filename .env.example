# Avani Albedo Configuration
# Copy this file to .env and configure your keys

# Mode: 'auto', 'live', or 'simulation'
APP_MODE=auto

# Gemini API Key (from https://aistudio.google.com/apikey)
# If empty, the system automatically uses the realistic expert climate intelligence fallback
GEMINI_API_KEY=

# Google Cloud Project Configuration (Optional for Cloud Run / Vertex AI / BigQuery)
GCP_PROJECT_ID=genai-2026
GCP_REGION=asia-south1

# Google Earth Engine (Optional, set to true once earthengine credentials exist)
USE_EARTH_ENGINE_LIVE=false

# Port configuration
PORT=8000
HOST=0.0.0.0

# Authentication & Judge Access Control
# Set AUTH_ENABLED=true to restrict access to whitelisted emails and judges
AUTH_ENABLED=true
JUDGE_PASSWORD=avani2026
ALLOWED_EMAILS=srbodkhe@gmail.com,judge@hackathon.com,evaluator@ai-builder.cup
